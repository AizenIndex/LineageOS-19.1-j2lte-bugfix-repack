From abe54819da5b9043ec88b82970d04ff06ef9a7ef Mon Sep 17 00:00:00 2001
From: AizenIndex <AizenIndex@users.noreply.github.com>
Date: Mon, 12 Oct 2026 04:53:50 +0530
Subject: [PATCH] universal3475-common: optimize interactive governor and
 init.rc for thermal stability

---
 ramdisk/etc/init.universal3475.rc | 12 +++++-------
 1 file changed, 5 insertions(+), 7 deletions(-)

diff --git a/ramdisk/etc/init.universal3475.rc b/ramdisk/etc/init.universal3475.rc
index 4c2377f..f87751c 100644
--- a/ramdisk/etc/init.universal3475.rc
+++ b/ramdisk/etc/init.universal3475.rc
@@ -5,9 +5,6 @@ import /vendor/etc/init/hw/init.samsung.rc
 import /vendor/etc/init/hw/init.power.rc
 
 on early-init
-    # Set SELinux to permissive for debugging boot issues
-    write /sys/fs/selinux/enforce 0
-
     mount debugfs /sys/kernel/debug /sys/kernel/debug mode=755
 
     # ZRAM setup
@@ -836,11 +833,12 @@ on property:sys.boot_completed=1
     swapon_all /vendor/etc/fstab.universal3475
 
     # CPU interactive governor thermal and energy tuning
+    # Using conservative values to reduce overheating: cap max freq, boost aggressively to finish quick, long delays
     write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
-    write /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq 800000
-    write /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load 85
-    write /sys/devices/system/cpu/cpufreq/interactive/target_loads "80 800000:85 1000000:90 1200000:95"
+    write /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq 507000
+    write /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load 95
+    write /sys/devices/system/cpu/cpufreq/interactive/target_loads "85 507000:95"
     write /sys/devices/system/cpu/cpufreq/interactive/min_sample_time 40000
     write /sys/devices/system/cpu/cpufreq/interactive/timer_rate 20000
     write /sys/devices/system/cpu/cpufreq/interactive/boostpulse_duration 40000
-    write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay "20000 1000000:40000 1200000:60000"
+    write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay "80000"
-- 
2.54.0.windows.1

